# Niente audit dopo npm install / npm ci: l'unico avviso che resta e' su una
# catena di sviluppo (esbuild dentro drizzle-kit) che online non c'e', e la
# proposta di npm per farlo tacere - `npm audit fix --force` - rompe l'albero
# delle dipendenze. Il perche' e' in fondo al README, «Sugli avvisi di npm audit».
audit=false
