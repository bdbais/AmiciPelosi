# Database (SQLite di default: nessun servizio esterno da avviare)
# Database locale di sviluppo (in produzione si usa Cloudflare D1)
LOCAL_DATABASE_URL="file:./data/local.db"

# Chiave per firmare i cookie di sessione: openssl rand -base64 32
AUTH_SECRET="cambia-questa-chiave-con-una-stringa-lunga-e-casuale"

# Chiavi VAPID per le notifiche push: npm run generate:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@amicipelosi.it"

# Accesso con Google (facoltativo): credenziali OAuth dalla Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
