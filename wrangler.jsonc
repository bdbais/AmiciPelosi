{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amici-pelosi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  // Database SQLite gestito da Cloudflare (piano gratuito).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amici-pelosi",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Le foto degli annunci: KV e incluso nel piano gratuito.
  // Se preferisci R2, aggiungi un binding "PHOTOS" e l'app lo usera al suo posto.
  "kv_namespaces": [
    {
      "binding": "PHOTOS_KV",
      "id": "0123456789abcdef0123456789abcdef"
    }
  ],

  "vars": {
    "VAPID_SUBJECT": "mailto:info@amicipelosi.it"
  }
}
