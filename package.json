{
  "name": "amici-pelosi",
  "version": "1.0.0",
  "private": true,
  "description": "Bacheca solidale per animali smarriti, ritrovati e in adozione, con notifiche di prossimita via GPS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "generate:vapid": "node scripts/generate-vapid.mjs",
    "test": "node --import tsx tests/webpush.test.ts",
    "seed:sql": "node --env-file=.env --import tsx scripts/export-seed-sql.ts",
    "cf:build": "prisma generate && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:d1:migrate": "wrangler d1 execute amici-pelosi --remote --file=migrations/0001_init.sql",
    "cf:d1:seed": "wrangler d1 execute amici-pelosi --remote --file=migrations/seed.sql",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate-local.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@opennextjs/cloudflare": "^1.20.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.128.0"
  }
}
